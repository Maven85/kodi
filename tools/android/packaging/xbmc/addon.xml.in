<addon id="@APP_PACKAGE@.@ANDROID_ARCH@" name="Maven's Kodi-Builds für Android" version="@JENKINS_BUILD_STRING@" provider-name="Maven">
	<requires>
		<import addon="xbmc.python" version="3.1.0"/>
	</requires>
	<extension point="android.binary" version="@ANDROID_ARCH@"/>
	<extension point="xbmc.addon.metadata">
		<summary lang="de">Q*-Build</summary>
		<source>https://github.com/Maven85/kodi/tree/23-android</source>
	</extension>
</addon>